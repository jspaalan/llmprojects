{
  "title": "GitHub Security Toolkit architecture",
  "canvas": { "width": 1200, "height": 720 },
  "grid": { "columns": 12, "rows": 7, "gap": 16, "padding": 36 },
  "layers": [
    { "id": "regions", "zIndex": 0, "elements": [
      { "id": "workflow", "kind": "container", "label": "CLIENT WORKFLOW", "position": { "c": 0, "r": 0, "w": 4, "h": 7 } },
      { "id": "toolkit", "kind": "outline", "label": "SECURITY TOOLKIT", "position": { "c": 4, "r": 0, "w": 5, "h": 7 } },
      { "id": "publishing", "kind": "container", "label": "PERSISTENCE\n& PRESENTATION", "position": { "c": 9, "r": 0, "w": 3, "h": 7 } }
    ]},
    { "id": "components", "zIndex": 10, "elements": [
      { "id": "source", "kind": "node", "label": "Repository\nsource", "icon": "Git", "position": { "c": 1, "r": 1, "w": 2, "h": 2 } },
      { "id": "image", "kind": "node", "label": "Docker image", "icon": "IMG", "position": { "c": 1, "r": 4, "w": 2, "h": 2 } },
      { "id": "scan", "kind": "node", "label": "Trivy & Semgrep", "icon": "SCAN", "position": { "c": 5, "r": 1, "w": 3, "h": 2 }, "style": { "accent": "#a78bfa" } },
      { "id": "builder", "kind": "node", "label": "Results builder", "icon": "JSON", "position": { "c": 5, "r": 4, "w": 3, "h": 2 }, "style": { "accent": "#fbbf24" } },
      { "id": "artifact", "kind": "node", "label": "History artifact", "icon": "DATA", "position": { "c": 10, "r": 1, "w": 1, "h": 2 } },
      { "id": "pages", "kind": "node", "label": "GitHub Pages", "icon": "SVG", "position": { "c": 10, "r": 4, "w": 1, "h": 2 }, "style": { "accent": "#34d399" } }
    ]},
    { "id": "status", "zIndex": 20, "elements": [
      { "id": "private", "kind": "badge", "label": "PRIVATE", "target": { "id": "pages", "corner": "top-right" }, "offset": { "c": 0, "r": 0 } }
    ]}
  ],
  "connections": [
    { "id": "source-scan", "from": { "element": "source", "port": "right" }, "to": { "element": "scan", "port": "left" } },
    { "id": "image-scan", "from": { "element": "image", "port": "right" }, "to": { "element": "scan", "port": "bottom" }, "waypoints": [{ "c": 4.35, "r": 5 }, { "c": 6.5, "r": 3.4 }] },
    { "id": "scan-builder", "from": { "element": "scan", "port": "bottom" }, "to": { "element": "builder", "port": "top" } },
    { "id": "builder-artifact", "from": { "element": "builder", "port": "right" }, "to": { "element": "artifact", "port": "bottom" }, "waypoints": [{ "c": 9.3, "r": 5 }] },
    { "id": "artifact-pages", "from": { "element": "artifact", "port": "bottom" }, "to": { "element": "pages", "port": "top" }, "style": { "arrow": "both", "stroke": "#34d399" } }
  ]
}
